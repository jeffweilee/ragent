# Path to a single YAML file or a directory of *.yaml files.
# Each file in directory mode defines one upstream system.
MCP_HUB_TOOLS_YAML=src/mcp_hub/tools.example.d

# Hub identity advertised to MCP clients
MCP_HUB_NAME=ragent-mcp-hub

# Bind address
MCP_HUB_HOST=0.0.0.0
MCP_HUB_PORT=9000

# Streamable HTTP mount path
MCP_HUB_PATH=/mcp

# Response modes (false = SSE streaming)
MCP_HUB_STATELESS_HTTP=false
MCP_HUB_JSON_RESPONSE=false

# Auth token (empty = auth disabled, startup warning emitted)
# The header name avoids occupying Authorization so callers can still
# forward user credentials via forward_headers.
MCP_HUB_AUTH_HEADER=X-MCP-Hub-Token
MCP_HUB_AUTH_TOKEN=

# Log level
LOG_LEVEL=INFO

# --- Secrets referenced in tool YAML via {% .Secrets.KEY %} ---
# These would be injected by VaultSecret CR in production.
# EXAMPLE_TOKEN=changeme
